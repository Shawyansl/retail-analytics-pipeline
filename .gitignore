# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===== Virtual Environment =====
venv/
env/
ENV/
.venv/

# ===== Environment variables / Secrets =====
.env
.env.local
*.env
config/secrets.*

# ===== Data files (raw & processed - never commit actual data) =====
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/processed/rejected_records/*
!data/processed/rejected_records/.gitkeep

# ===== Generated outputs =====
reports/charts/*
!reports/charts/.gitkeep

# ===== Docker =====
# (docker-compose.yml and Dockerfile SHOULD be committed - only ignore volumes/data)
postgres_data/

# ===== IDE / Editor =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Logs =====
*.log
logs/
!logs/.gitkeep

