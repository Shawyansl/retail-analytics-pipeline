# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===== Virtual Environment =====
venv/
env/
ENV/
.venv/

# ===== Environment variables / Secrets =====
#.env
#.env.local
#*.env
#config/secrets.*

# ===== Data files (raw & processed - never commit actual data) =====
data/raw/*
!data/raw/.gitkeep

# Keep the rejected_records/ subdirectory itself: load.py writes into it and cannot
# create it, so a fresh clone crashes without the .gitkeep. Note the pattern is
# `data/processed/*` and not `data/processed/`: a bare directory pattern stops git from
# descending into it at all, which makes any later `!` negation unreachable.
data/processed/*
!data/processed/.gitkeep
!data/processed/rejected_records/
data/processed/rejected_records/*
!data/processed/rejected_records/.gitkeep

# ===== Generated outputs =====
reports/charts/*
!reports/charts/.gitkeep

# ===== Docker =====
# (docker-compose.yml and Dockerfile SHOULD be committed - only ignore volumes/data)
postgres_data/

# ===== IDE / Editor =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Logs =====
# `logs/*` rather than `logs/`, same reason as data/processed above -- the .gitkeep has to
# stay tracked or the FileHandler in every module raises on import in a fresh clone.
logs/*
!logs/.gitkeep